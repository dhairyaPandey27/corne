// Should be before including header for pointing 

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1100  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { flavor = "tap-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <17 18>;
            layers = <0>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
            layers = <0>;
            timeout-ms = <220>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none  &kp Q           &kp W               &kp E           &kp R  &kp T          &kp Y      &kp U            &kp I           &kp O               &kp P              &none
&none  &hm LEFT_GUI A  &hm LEFT_CONTROL S  &hm LEFT_ALT D  &kp F  &kp G          &kp H      &kp J            &hm LEFT_ALT K  &hm LEFT_CONTROL L  &hm LEFT_GUI SEMI  &none
&none  &kp Z           &kp X               &kp C           &kp V  &kp B          &kp N      &kp M            &kp COMMA       &kp DOT             &kp FSLH           &none
                                           &kp LEFT_SHIFT  &mo 1  &lt 4 ENTER    &kp SPACE  &lt 2 BACKSPACE  &kp ESCAPE
            >;
        };

        symbols {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN           &kp HASH  &kp DOLLAR  &kp PERCENT       &kp CARET  &kp AMPERSAND  &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LESS_THAN    &kp GREATER_THAN      &trans    &kp MINUS   &kp UNDERSCORE    &kp PLUS   &kp EQUAL      &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans
&trans  &kp PIPE         &kp NON_US_BACKSLASH  &trans    &trans      &trans            &kp GRAVE  &kp TILDE      &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
                                               &trans    &trans      &trans            &trans     &trans         &trans
            >;
        };

        numbers {
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
&none  &none   &none   &none   &none   &none     &none   &none   &none   &none   &none   &none
&none  &none   &none   &none   &none   &none     &none   &none   &none   &none   &none   &none
                       &none   &mo 3   &none     &none   &none   &none
            >;
        };

        function {
            bindings = <
&none  &kp F1        &kp F2        &kp F3           &kp F4                &kp F5                  &kp F6      &kp F7            &kp F8      &kp F9      &kp F10         &none
&none  &kp K_MUTE    &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp F11     &kp F12         &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3          &bt BT_SEL 4            &none       &none             &none       &bt BT_CLR  &bt BT_CLR_ALL  &none
                                   &none            &none                 &none                   &none       &none             &none
            >;
        };

        navigation {
            bindings = <
&none  &none  &none  &none  &none  &none    &kp HOME    &kp PAGE_UP   &kp PAGE_DOWN   &kp END    &none  &none
&none  &none  &none  &none  &none  &none    &kp LEFT    &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none  &none
&none  &to 5  &none  &none  &none  &none    &none       &none         &none           &none      &none  &none
                     &none  &none  &none    &kp DELETE  &none         &none
            >;
        };

        mouse {
            bindings = <
&none  &none  &none  &none  &none  &none    &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none  &none
&none  &none  &none  &none  &none  &none    &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none  &none  &none  &none  &none  &none    &none           &none         &none           &none            &none  &none
                     &none  &to 0  &none    &mkp MB1        &mkp MB2      &mkp MB3
            >;
        };
    };
};
